from tkinter import *
from tkinter import messagebox

class ToDoApp:
    def __init__(self, root):
        self.root = root
        self.root.title("To-Do List")
        self.root.geometry("400x500")
        self.root.config(bg="lightblue")
        
       
        self.title_label = Label(self.root, text="To-Do List", font=("Arial", 20, "bold"), bg="lightblue", fg="black")
        self.title_label.pack(pady=10)
        
        
        self.task_listbox = Listbox(self.root, width=40, height=15, font=("Arial", 12), bg="white", fg="black", bd=2, selectmode=SINGLE)
        self.task_listbox.pack(pady=10)
        
      
        self.task_entry = Entry(self.root, width=30, font=("Arial", 12))
        self.task_entry.pack(pady=10)
        
       
        self.add_button = Button(self.root, text="Add Task", width=12, font=("Arial", 12), bg="green", fg="white", command=self.add_task)
        self.add_button.pack(pady=5)
        
        
        self.delete_button = Button(self.root, text="Delete Task", width=12, font=("Arial", 12), bg="red", fg="white", command=self.delete_task)
        self.delete_button.pack(pady=5)
        
        
        self.clear_button = Button(self.root, text="Clear All", width=12, font=("Arial", 12), bg="orange", fg="white", command=self.clear_all)
        self.clear_button.pack(pady=5)
    
    def add_task(self):
        task = self.task_entry.get().strip()
        if task:
            self.task_listbox.insert(END, task)
            self.task_entry.delete(0, END)
        else:
            messagebox.showwarning("Warning", "Task cannot be empty!")

    def delete_task(self):
        try:
            selected_task_index = self.task_listbox.curselection()[0]
            self.task_listbox.delete(selected_task_index)
        except IndexError:
            messagebox.showerror("Error", "No task selected to delete!")

    def clear_all(self):
        confirm = messagebox.askyesno("Confirmation", "Are you sure you want to clear all tasks?")
        if confirm:
            self.task_listbox.delete(0, END)

# Main Function
if __name__ == "__main__":
    root = Tk()
    app = ToDoApp(root)
    root.mainloop()
